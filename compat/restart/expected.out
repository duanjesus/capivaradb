## server started on an empty file
-- First server process: create and fill a database on disk.
create table capivaras (
    id      int primary key,
    name    text not null unique,
    weight  double precision default 45.5,
    wild    boolean default true
);
CREATE TABLE
create index capivaras_weight on capivaras (weight);
CREATE INDEX
insert into capivaras (id, name, weight) values (1, 'Filó', 48.5), (2, 'Bolota', 61), (3, 'Pingo', 35.2);
INSERT 0 3
insert into capivaras (id, name) values (4, 'Padrão');
INSERT 0 1
update capivaras set wild = false where name = 'Bolota';
UPDATE 1
delete from capivaras where id = 3;
DELETE 1
select * from capivaras;
 id |  name  | weight | wild 
----+--------+--------+------
  1 | Filó   |   48.5 | t
  2 | Bolota |     61 | f
  4 | Padrão |   45.5 | t
(3 rows)

-- A transaction left open: the server is killed while it is in progress.
begin;
BEGIN
insert into capivaras (id, name) values (99, 'Fantasma');
INSERT 0 1
update capivaras set weight = 0;
UPDATE 4
select id, name, weight from capivaras order by id;
 id |   name   | weight 
----+----------+--------
  1 | Filó     |      0
  2 | Bolota   |      0
  4 | Padrão   |      0
 99 | Fantasma |      0
(4 rows)

-- No COMMIT, no CHECKPOINT, no clean shutdown: the server is killed here.

## server killed with kill -9; a new one opens the same files
recovered from the log: N records, N page changes replayed, N unfinished transactions rolled back
-- Second server process, same file. What was committed is there; the
-- transaction that was open when the server died is gone without a trace.
select * from capivaras;
 id |  name  | weight | wild 
----+--------+--------+------
  1 | Filó   |   48.5 | t
  2 | Bolota |     61 | f
  4 | Padrão |   45.5 | t
(3 rows)

-- So are the rules: the primary key, the unique name, the defaults.
insert into capivaras values (1, 'Outra', 1, true);
ERROR:  duplicate key value violates unique constraint "capivaras_pkey"
DETAIL:  Key (id)=(1) already exists.
insert into capivaras (id, name) values (5, 'Filó');
ERROR:  duplicate key value violates unique constraint "capivaras_name_key"
DETAIL:  Key (name)=(Filó) already exists.
insert into capivaras (id, name) values (5, 'Nova');
INSERT 0 1
select name, weight, wild from capivaras where id = 5;
 name | weight | wild 
------+--------+------
 Nova |   45.5 | t
(1 row)

-- The offline check at the end compares the index with the rows, entry by
-- entry.
-- (Queries do not use indexes yet: choosing one is the planner's job.)
select name from capivaras where weight > 46 order by weight;
  name  
--------
 Filó
 Bolota
(2 rows)


## offline check of the file
ok: 1 tables, 2 indexes, 4 rows; N pages
